    {
      "name": "04_Order_Creation_Checkout",
      "description": "Checkout process, order creation, order tracking, and empty cart guard.",
      "item": [
        {
          "name": "Checkout Cart - Place Order (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 201\", function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "pm.test(\"Order created with PENDING status\", function () {",
                  "    var json = pm.response.json();",
                  "    var order = json.order || json;",
                  "    pm.expect(order._id).to.be.a('string');",
                  "    pm.expect(order.vendorStatus).to.eql('PENDING');",
                  "    pm.environment.set(\"orderId\", order._id);",
                  "    if (order.deliveryOtp) {",
                  "        pm.environment.set(\"deliveryOtp\", order.deliveryOtp);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentType\": \"COD\",\n  \"deliveryAddress\": {\n    \"street\": \"Alka Cinema Road\",\n    \"area\": \"Vadva\",\n    \"city\": \"Rajkot\",\n    \"state\": \"Gujarat\",\n    \"pincode\": \"360001\",\n    \"fullAddress\": \"Alka Cinema Road, Vadva, Rajkot\",\n    \"customerName\": \"Test Customer\",\n    \"phone\": \"9876543210\",\n    \"location\": { \"lat\": 22.2842, \"lng\": 70.7963 }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cart/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "checkout"]
            }
          }
        },
        {
          "name": "Checkout with Empty Cart (400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Error indicates cart is empty\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.message.toLowerCase()).to.include('empty');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentType\": \"COD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cart/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "checkout"]
            }
          }
        },

    {
      "name": "05_Vendor_State_Machine",
      "description": "Vendor lifecycle transitions: PENDING -> ACCEPTED -> PREPARING -> READY, max 3 featured rule, and 400/403 guards.",
      "item": [
        {
          "name": "Vendor Get Store Orders (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns vendor orders\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.orders || json).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{vendorToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendor/orders",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "orders"]
            }
          }
        },
        {
          "name": "Vendor Advance: PENDING -> ACCEPTED (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Vendor status updated to ACCEPTED\", function () {",
                  "    var json = pm.response.json();",
                  "    var order = json.order || json;",
                  "    pm.expect(order.vendorStatus).to.eql('ACCEPTED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{vendorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACCEPTED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vendor/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "orders", "{{orderId}}", "status"]
            }
          }
        },
        {
          "name": "Vendor Advance: ACCEPTED -> PREPARING (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Vendor status updated to PREPARING\", function () {",
                  "    var json = pm.response.json();",
                  "    var order = json.order || json;",
                  "    pm.expect(order.vendorStatus).to.eql('PREPARING');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",

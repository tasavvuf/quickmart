{
  "info": {
    "_postman_id": "vingo-api-collection-v1",
    "name": "Vingo (QuickMart) API Test Suite",
    "description": "Comprehensive Postman test collection with assertions for 4 roles (Customer, Vendor, Delivery Partner, Admin), auth, order creation, dual state machine order transitions, and 400/401/403/409 error paths.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01_Auth",
      "description": "Authentication and authorization test suite for all 4 roles and error conditions.",
      "item": [
        {
          "name": "Login - Customer (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has JWT token and user profile\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.token).to.be.a('string');",
                  "    pm.expect(json.user).to.be.an('object');",
                  "    pm.expect(json.user.role).to.eql('user');",
                  "    pm.environment.set(\"customerToken\", json.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{customerEmail}}\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"role\": \"user\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login - Vendor (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {

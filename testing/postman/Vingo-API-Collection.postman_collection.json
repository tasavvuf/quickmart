    {
      "name": "02_Stores_Catalog",
      "description": "Store discovery, location filtering, and catalog endpoints.",
      "item": [
        {
          "name": "Get Nearby Stores (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns array of stores\", function () {",
                  "    var json = pm.response.json();",
                  "    var stores = json.stores || json;",
                  "    pm.expect(stores).to.be.an('array');",
                  "    pm.expect(stores.length).to.be.above(0);",
                  "    pm.environment.set(\"storeId\", stores[0]._id || stores[0].id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stores?lat={{lat}}&lng={{lng}}",
              "host": ["{{baseUrl}}"],
              "path": ["stores"],
              "query": [
                { "key": "lat", "value": "{{lat}}" },
                { "key": "lng", "value": "{{lng}}" }
              ]
            }
          }
        },
        {
          "name": "Get Store By ID & Catalog (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Store details and product list present\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.store || json).to.be.an('object');",
                  "    var products = json.products || (json.store && json.store.products) || [];",
                  "    if (products.length > 0) {",
                  "        pm.environment.set(\"productId\", products[0]._id || products[0].id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stores/{{storeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["stores", "{{storeId}}"]
            }
          }
        },
        {
          "name": "Get Store Featured Products (Max 3 Enforced)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Featured products count is at most 3\", function () {",
                  "    var json = pm.response.json();",
                  "    var prods = json.featuredProducts || json.products || json;",
                  "    pm.expect(prods).to.be.an('array');",
                  "    pm.expect(prods.length).to.be.at.most(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stores/{{storeId}}/featured",
              "host": ["{{baseUrl}}"],
              "path": ["stores", "{{storeId}}", "featured"]
            }
          }
        }
      ]
    },
